# Copy this file to ".env" and fill in real values. NEVER commit ".env".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Long random string that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# --- Optional / production only ---
# FLASK_ENV=production      # on the real server: HTTPS-only cookies + HSTS. Never use with FLASK_DEBUG.
# PROXY_HOPS=1              # only if a trusted reverse proxy sits in front: lets the rate limiter see real visitor IPs.
# FLASK_DEBUG=1             # ONLY on your own laptop while developing. Never on a server.

# --- Browser push notifications (optional; leave all three out to turn push off) ---
# Make the keys with:  python tools/make_vapid_keys.py
# VAPID_PUBLIC_KEY=   (public: sent to browsers)
# VAPID_PRIVATE_KEY=  (SECRET: signs push messages. Never share or commit it)
# VAPID_SUBJECT=mailto:you@example.com
# --- ESP32 reader on your home network ---
# HOST=0.0.0.0        # lets the ESP32 reach this computer. Only on a network you trust.
